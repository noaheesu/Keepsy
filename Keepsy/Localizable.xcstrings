            "value": "장보기"
          }
        }
      }
    },
    "Skip": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "건너뛰기"
          }
        }
      }
    },
    "Soonest %@": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 급한 것 %@"
          }
        }
      }
    },
    "Spinach": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시금치"
          }
        }
      }
    },
    "Swipe items as used up or long-press them as thrown away to see how much gets wasted.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "밀어서 \"다 씀\", 길게 눌러 \"버렸어요\"를 기록하면 얼마나 버리는지 보여드려요."
          }
        }
      }
    },
    "Swipe left when you finish something. Swipe right when you buy it again, and Keepsy fills in where it goes and how long it lasts.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다 쓰면 왼쪽으로 밀고, 또 사면 오른쪽으로 밀어요. 어디에 두는지, 얼마나 가는지는 Keepsy가 채워드려요."
          }
        }
      }
    },
    "Swipe when things change": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바뀌면 밀어주세요"
          }
        }
      }
    },
    "This can't be undone.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "되돌릴 수 없어요."
          }
        }
      }
    },
    "This week": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 주"
          }
        }
      }
    },
    "Threw Away": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버렸어요"
          }
        }
      }
    },
    "Thrown away": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버림"
          }
        }
      }
    },
    "Thrown away most": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자주 버리는 것"
          }
        }
      }
    },
    "Time": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간"
          }
        }
      }
    },
    "To scan dates, allow Keepsy to use the camera in Settings.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "날짜를 스캔하려면 설정에서 Keepsy의 카메라 사용을 허용해 주세요."
          }
        }
      }
    },
    "Today or tomorrow": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘·내일"
          }
        }
      }
    },
    "Touch and hold an item to change how much is left, move it to the freezer, or mark it as thrown away.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "물건을 길게 누르면 남은 양을 바꾸거나, 냉동실로 옮기거나, 버렸다고 표시할 수 있어요."
          }
        }
      }
    },
    "Turn On Reminders": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림 켜기"
          }
        }
      }
    },
    "Type what you need above. Things that run out, or that you usually buy around now, show up here.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "필요한 걸 위에 입력하세요. 다 떨어졌거나 평소 살 때가 된 물건은 여기에 나와요."
          }
        }
      }
    },
    "Used": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다 씀"
          }
        }
      }
    },
    "Used up": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다 씀"
          }
        }
      }
