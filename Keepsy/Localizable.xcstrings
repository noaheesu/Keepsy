          "stringUnit": {
            "state": "translated",
            "value": "버전"
          }
        }
      }
    },
    "Waste": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버림 통계"
          }
        }
      }
    },
    "Wasted": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버린 비율"
          }
        }
      }
    },
    "Within %lld days": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld일 이내"
          }
        }
      }
    },
    "Your items stay on this iPhone. Nothing is sent to us.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 기록은 이 iPhone에만 저장되고, 저희에게 전송되지 않아요."
          }
        }
      }
    },
    "Your list is empty": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목록이 비어 있어요"
